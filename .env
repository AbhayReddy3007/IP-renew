# ── combine_master_loe pipeline configuration ──────────────────────────────
# Fill in your own values below. Anything left blank/commented out falls
# back to the hardcoded default in config.py. CLI flags (e.g. --project)
# always take priority over these if you pass them explicitly.

# Path to a GCP service-account JSON key file.
# If left blank, falls back to Application Default Credentials.
GCS_CREDENTIALS=/path/to/service_account.json

# ── Source tables (forecasted_loe / loe_table_2) ───────────────────────────
BQ_PROJECT=cognito-prod-394707
BQ_DATASET=cognito_prod_datamart

# ── d1/d2 output location ──────────────────────────────────────────────────
# Fill these in with the project/dataset you want d1 and d2 created in.
# Left blank, d1/d2 default to the source project/dataset above instead.
TARGET_PROJECT=
TARGET_DATASET=
D1_TABLE=d1
D2_TABLE=d2

# ── patent_discovery / patent_master location ──────────────────────────────
# Independent of both the source tables and the d1/d2 target above.
PATENT_PROJECT=cognito-dev-380506
PATENT_DATASET=stage
